#!/bin/sh
# Slim pre-commit hook (#3303).
#
# Goal: average run time < 2s. Only fast, staged-only checks live here.
# Heavier verification (clippy, openapi/SDK codegen drift) is handled by
# scripts/hooks/pre-push and CI.
#
# Install: git config core.hooksPath scripts/hooks
#
# Checks performed:
#   1. cargo fmt --check on staged *.rs files only (no full-workspace scan)
#   2. CHANGELOG guard: reject duplicate `## [Unreleased]` headings (#3395),
#      plus `(@user)` attribution on staged [Unreleased] bullets and staged
#      changelog.d/ fragments (#3400)
#   3. gitleaks scan of staged changes (soft-warn if gitleaks is missing;
#      set LIBREFANG_SKIP_SECRETS_SCAN=1 to silence the warning)
#   4. openapi.sha256 baseline auto-sync when openapi.json is staged (#4690)

set -eu

HOOK_TMP=$(mktemp -d "${TMPDIR:-/tmp}/librefang-pre-commit.XXXXXX")
trap 'rm -rf "$HOOK_TMP"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Portable sha256 shim. `shasum -a 256` ships on macOS by default
# (perl-provided) but is absent on many Linux dev boxes (Debian /
# Ubuntu / Alpine slim images) that only carry GNU coreutils'
# `sha256sum`. Prefer `sha256sum` when available, fall back to
# `shasum -a 256`, and let callers detect "neither installed" via
# the helper's exit code. (#5664 sub-finding 2.)
sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$@"
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$@"
    else
        return 127
    fi
}

# 1. Format check, staged Rust files only.
#
# `cargo fmt --check -- <paths>` silently ignores the path arguments and
# rescans the whole workspace, so the hook used to fail on pre-existing
# fmt drift in files the committer never touched. Invoke `rustfmt`
# directly so the path scope actually sticks. Edition is hardcoded to
# match `workspace.package.edition` in the root Cargo.toml.
#
# NUL-delimited input so paths containing spaces, quotes, or shell
# metacharacters (`with space.rs`, `weird $name.rs`) are not word-split.
# Each exact index blob is materialized under the private temporary tree;
# rustfmt never reads a newer unstaged working-tree post-image.
STAGED_RUST="$HOOK_TMP/staged-rust"
git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs' >"$STAGED_RUST"
if [ -s "$STAGED_RUST" ]; then
    if command -v rustfmt >/dev/null 2>&1; then
        STAGED_RUST_TREE="$HOOK_TMP/staged-rust-tree"
        STAGED_RUSTFMT_CONFIG="$HOOK_TMP/rustfmt.toml"
        mkdir -p "$STAGED_RUST_TREE"
        if ! git show :rustfmt.toml >"$STAGED_RUSTFMT_CONFIG"; then
            echo "Error: unable to read staged rustfmt.toml from the index." >&2
            exit 1
        fi
        if ! xargs -0 -n 1 sh -c '
            set -e
            staged_root=$1
            rustfmt_config=$2
            file=$3
            metadata=$(git ls-files -s -- "$file")
            tab=$(printf "\t")
            case "$metadata" in
                100644\ *\ 0"$tab"*|100755\ *\ 0"$tab"*) ;;
                *) exit 0 ;;
            esac
            staged_file=$staged_root/$file
            mkdir -p "$(dirname "$staged_file")"
            git show ":$file" >"$staged_file"
            rustfmt --check --edition 2021 --config-path "$rustfmt_config" \
                --config skip_children=true "$staged_file"
        ' sh "$STAGED_RUST_TREE" "$STAGED_RUSTFMT_CONFIG" \
            <"$STAGED_RUST" >/dev/null 2>&1; then
            echo "Error: staged Rust files are not rustfmt-clean."
            echo "Run: git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs' \\"
            echo "       | xargs -0 rustfmt --edition 2021"
            echo "Then re-stage and commit again."
            exit 1
        fi
    else
        # Soft-skip when no native rustfmt is installed (e.g. a Docker-only
        # host — see CLAUDE.md > Build & Verify). Mirrors the gitleaks
        # step below; verify formatting in the dev container instead.
        echo "Warning: rustfmt not on PATH; skipping staged-Rust fmt check." >&2
        echo "         Verify in the dev container (CLAUDE.md > Build & Verify)." >&2
    fi
fi

# 2. CHANGELOG.md duplicate-Unreleased guard. Release tooling
# (`.github/workflows/release.yml` awk extractor and
# `xtask/src/changelog.rs`) silently picks the first match and drops
# subsequent blocks. See #3395.
STAGED_NAMES=$(git diff --cached --name-only)
if printf '%s\n' "$STAGED_NAMES" | grep -qx "CHANGELOG.md"; then
    STAGED_CHANGELOG="$HOOK_TMP/CHANGELOG.md"
    if ! git show :CHANGELOG.md >"$STAGED_CHANGELOG"; then
        echo "Error: unable to read staged CHANGELOG.md from the index." >&2
        exit 1
    fi
    UNRELEASED_COUNT=$(grep -c '^## \[Unreleased\]' "$STAGED_CHANGELOG" || true)
    if [ "$UNRELEASED_COUNT" -gt 1 ]; then
        echo "Error: CHANGELOG.md has $UNRELEASED_COUNT '## [Unreleased]' sections; expected exactly 1."
        echo "Release tooling will silently drop entries from all but the first. Merge them into one block."
        exit 1
    fi
fi

# 2b. (@username) attribution on staged additions to [Unreleased] AND on staged
# changelog.d/ fragments. See #3400. A fragment is an [Unreleased] bullet with a
# delay on it, so it has to be gated here as well — a PR that writes a fragment
# never touches CHANGELOG.md, and gating on that path alone would let every
# fragment through unchecked. Only fails on what the staged diff adds; never
# penalises historical entries. Soft-skip if python3 is missing.
if printf '%s\n' "$STAGED_NAMES" | grep -qE '^(CHANGELOG\.md$|changelog\.d/)'; then
    if command -v python3 >/dev/null 2>&1; then
        if ! python3 scripts/check-changelog-attribution.py --staged; then
            echo 'Error: a staged CHANGELOG.md [Unreleased] bullet or changelog.d/ fragment is'
            echo '       missing a `(@your-github-login)` suffix, or a fragment sits in a section'
            echo '       directory assembly does not recognise. See the paths listed above.'
            echo '       Audit everything pending: python3 scripts/check-changelog-attribution.py --all-unreleased'
            exit 1
        fi
    else
        echo "warning: python3 not available; skipping CHANGELOG attribution check." >&2
    fi
fi

# 3. Secret detection (gitleaks). Soft-warn when gitleaks is not installed.
#
# Unlike the old detect-secrets setup, there is no per-finding baseline to
# drift: gitleaks scans against a fixed rule set plus the path/regex
# allowlists in .gitleaks.toml. A tool-less local commit therefore cannot
# push a stale baseline to main the way detect-secrets could — the worst
# case is CI's `secrets` job catches a real leak instead of this hook. So a
# missing tool soft-warns (mirroring the rustfmt soft-skip) rather than
# hard-erroring. Silence the warning on a deliberately tool-less host with
# LIBREFANG_SKIP_SECRETS_SCAN=1.
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --config .gitleaks.toml --redact --no-banner; then
        echo "Error: gitleaks flagged a potential credential in the staged diff." >&2
        echo "If this is a real secret: unstage it; rotate it if it ever hit disk." >&2
        echo "If this is a false positive: add a path/regex to [allowlist] in .gitleaks.toml." >&2
        exit 1
    fi
elif [ "${LIBREFANG_SKIP_SECRETS_SCAN:-0}" = "1" ]; then
    : # deliberately tool-less host; stay quiet
else
    echo "warning: gitleaks not installed; staged secret scan skipped (CI is the gate)." >&2
    echo "  install: brew install gitleaks  (or see https://github.com/gitleaks/gitleaks/releases)" >&2
fi

# 4. openapi.sha256 baseline auto-sync (#4690).
#
# When openapi.json is in the staged diff, recompute its sha256 and
# auto-stage the matching xtask/baselines/openapi.sha256 line so the
# bump commit is internally consistent. Without this, every version
# bump (or any direct openapi.json edit) lands a baseline mismatch
# that the openapi-drift CI gate rejects, forcing a follow-up fixup
# commit (PR #4695 was such a fixup). cargo xtask schema-check gen
# is too slow for a sub-2s pre-commit, so this hook does the same
# single-line update via plain shasum.
#
# Uses the `sha256` shim defined at the top of this file so Linux
# dev boxes that only ship GNU coreutils' `sha256sum` (and not
# `shasum`) are handled the same as macOS. (#5664 sub-finding 2.)
if git diff --cached --name-only | grep -qx "openapi.json"; then
    BASELINE_FILE="xtask/baselines/openapi.sha256"
    STAGED_OPENAPI="$HOOK_TMP/openapi.json"
    STAGED_BASELINE="$HOOK_TMP/openapi.sha256"
    if ! git show :openapi.json >"$STAGED_OPENAPI"; then
        echo "Error: unable to read staged openapi.json from the index." >&2
        exit 1
    fi
    if ! git show ":$BASELINE_FILE" >"$STAGED_BASELINE"; then
        echo "Error: unable to read staged $BASELINE_FILE from the index." >&2
        exit 1
    fi
    if EXPECTED_LINE=$(sha256 "$STAGED_OPENAPI" 2>/dev/null); then
        EXPECTED=$(printf '%s' "$EXPECTED_LINE" | awk '{print $1}')
        RECORDED=$(awk '{print $1}' "$STAGED_BASELINE")
        if [ "$EXPECTED" != "$RECORDED" ]; then
            if ! git diff --quiet -- "$BASELINE_FILE"; then
                echo "Error: $BASELINE_FILE has unstaged changes; refusing to overwrite them." >&2
                echo "Stage or discard those changes, then retry the commit." >&2
                exit 1
            fi
            printf '%s  openapi.json\n' "$EXPECTED" >"$BASELINE_FILE"
            git add "$BASELINE_FILE"
            echo "info: auto-staged refreshed openapi.sha256 baseline (#4690)" >&2
        fi
    else
        echo "warning: neither sha256sum nor shasum available; skipping openapi baseline sync." >&2
        echo "  CI openapi-drift gate may reject this commit." >&2
    fi
fi

# 5. Sidecar-first policy: block in-process channel adapters not on
# the allowlist. Checks ADDED *and MODIFIED* staged files under
# crates/librefang-channels/src/ — so a stub file + a follow-up commit
# that adds the impl can't slip past the added-only window. New
# channels must be sidecar adapters. This hook is fast feedback only;
# `cargo xtask channel-policy` runs the same check tree-wide in CI on
# every PR and is the authoritative gate (an unset core.hooksPath or
# --no-verify can't bypass that). Known, accepted limitation: a
# macro-generated impl, or a new adapter impl added inside an
# already-allowlisted file, is not detected — this is a policy
# ratchet, not a security boundary.
ALLOWLIST="crates/librefang-channels/src/channels-allowlist.txt"
STAGED_ALLOWLIST="$HOOK_TMP/channels-allowlist.txt"
if ! git show ":$ALLOWLIST" >"$STAGED_ALLOWLIST" 2>/dev/null; then
    : >"$STAGED_ALLOWLIST"
fi
check_staged_channels() {
    STAGED_CHANNELS="$HOOK_TMP/staged-channels"
    VIOLATIONS="$HOOK_TMP/channel-violations"
    git diff --cached --name-only --diff-filter=ACMR -- \
        crates/librefang-channels/src >"$STAGED_CHANNELS" 2>/dev/null || true
    : >"$VIOLATIONS"
    while IFS= read -r f; do
        case "$f" in
            crates/librefang-channels/src/*.rs)
                relative=${f#crates/librefang-channels/src/}
                case "$relative" in
                    */*) base=${relative%%/*} ;;
                    *) base=${relative%.rs} ;;
                esac
                ;;
            *) continue ;;
        esac
        if git show ":$f" 2>/dev/null \
            | grep -Eq '^[[:space:]]*(unsafe[[:space:]]+)?impl([^[:alnum:]_]|$)(.*[^[:alnum:]_])?ChannelAdapter[[:space:]]+for[[:space:]]+'; then
            if ! grep -qx "$base" "$STAGED_ALLOWLIST"; then
                printf '%s\n' "$f" >>"$VIOLATIONS"
            fi
        fi
    done <"$STAGED_CHANNELS"
    if [ -s "$VIOLATIONS" ]; then
        echo "Error: in-process channel adapter(s) not allowed:" >&2
        while IFS= read -r v; do echo "  - $v" >&2; done <"$VIOLATIONS"
        echo "" >&2
        echo "LibreFang is sidecar-first. Ship a new channel as an" >&2
        echo "out-of-process sidecar adapter (Python or any language):" >&2
        echo "  examples/sidecar-channel-python/adapter.py (template) + the librefang.sidecar SDK" >&2
        echo "Grandfathering an in-process adapter needs explicit" >&2
        echo "maintainer approval: add the basename to $ALLOWLIST in a" >&2
        echo "separate, reviewed commit." >&2
        exit 1
    fi

    # Defense-in-depth (soft warn only): a new in-process registration
    # in channel_bridge.rs also implies a new adapter, but that file
    # is edited often for *existing* channels and feature names differ
    # from module basenames, so a hard match would false-positive.
    # The file check above is the authoritative gate.
    if git diff --cached --name-only \
        | grep -qx "crates/librefang-api/src/channel_bridge.rs"; then
        if git diff --cached -U0 -- \
            crates/librefang-api/src/channel_bridge.rs 2>/dev/null \
            | grep -qE '^\+.*Adapter::new'; then
            echo "note: channel_bridge.rs adds an *Adapter::new call." >&2
            echo "  If this wires a NEW in-process channel, it must" >&2
            echo "  instead be a sidecar adapter (see the policy above)." >&2
        fi
    fi
}
check_staged_channels
