{
  "name": "librefang-web-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3"
    }
  },
  "scripts": {
    "predev": "tsx scripts/fetch-registry.ts && tsx scripts/gen-og-images.ts && tsx scripts/gen-rss.ts",
    "dev": "vite",
    "fetch-registry": "tsx scripts/fetch-registry.ts",
    "gen-og": "tsx scripts/gen-og-images.ts",
    "gen-rss": "tsx scripts/gen-rss.ts",
    "i18n:audit": "tsx scripts/audit-locale-completeness.ts",
    "prebuild": "tsx scripts/fetch-registry.ts && tsx scripts/gen-og-images.ts && tsx scripts/gen-rss.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
