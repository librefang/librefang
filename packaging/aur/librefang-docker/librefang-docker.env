# LibreFang Docker runtime settings.
#
# This package pins the upstream release image instead of using "latest".
LIBREFANG_DOCKER_IMAGE=ghcr.io/librefang/librefang:2026.7.31
LIBREFANG_DOCKER_NAME=librefang
LIBREFANG_DOCKER_DATA_VOLUME=librefang-data
LIBREFANG_DOCKER_PORT=4545
# Authentication is required by default.
# Set one of LIBREFANG_API_KEY or the LIBREFANG_DASHBOARD_USER/LIBREFANG_DASHBOARD_PASS pair below before starting the service, or the daemon will refuse to bind and the container will exit immediately.
# Set LIBREFANG_ALLOW_NO_AUTH to 1 only for an explicit, loopback-only development deployment where every local user is trusted.
LIBREFANG_ALLOW_NO_AUTH=0
#
# Authentication (set at least one before first start unless LIBREFANG_ALLOW_NO_AUTH=1):
# LIBREFANG_API_KEY=
# LIBREFANG_DASHBOARD_USER=
# LIBREFANG_DASHBOARD_PASS=
#
# Optional provider/channel credentials:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
